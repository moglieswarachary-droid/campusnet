# ==========================================
# CAMPUSNET BACKEND CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3199

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/campusnet_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/campusnet_db?schema=public"

# Authentication & Session Security
JWT_SECRET="replace_with_64_byte_random_cryptographic_secret_key"
JWT_EXPIRES_IN="24h"
SESSION_SECRET="replace_with_random_session_encryption_secret"

# Allowed CORS Origins (Comma-separated in production)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
