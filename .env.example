# ==========================================
# CAMPUSNET PRODUCTION CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env and configure with your specific environment variables.
# Do NOT commit actual .env files containing real secrets to version control.

# Application Server
NODE_ENV=development
PORT=3199

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres_placeholder_password@localhost:5432/campusnet_db?schema=public"

# Direct URL for migrations (Required when using connection poolers like PgBouncer / Supabase / Neon)
DIRECT_URL="postgresql://postgres:postgres_placeholder_password@localhost:5432/campusnet_db?schema=public"

# Authentication & Session Security (To be generated using `openssl rand -hex 64`)
JWT_SECRET="replace_with_64_byte_random_cryptographic_secret_key"
JWT_EXPIRES_IN="24h"
SESSION_SECRET="replace_with_random_session_encryption_secret"

# Allowed CORS Origins (Comma-separated URLs in production)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Future Object Storage (Cloudflare R2 / AWS S3)
STORAGE_BUCKET_NAME="campusnet-assets-placeholder"
STORAGE_ENDPOINT="https://placeholder-account-id.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="placeholder_access_key_id"
STORAGE_SECRET_ACCESS_KEY="placeholder_secret_access_key"

# Future Real-Time & WebRTC
LIVEKIT_API_KEY="placeholder_livekit_api_key"
LIVEKIT_API_SECRET="placeholder_livekit_api_secret"
LIVEKIT_URL="wss://placeholder.livekit.cloud"
