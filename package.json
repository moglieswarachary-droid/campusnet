{
  "name": "campusnet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@campusnet/frontend",
    "dev:backend": "npm run dev --workspace=@campusnet/backend",
    "build": "npm run build --workspace=@campusnet/frontend",
    "build:backend": "npm run prisma:generate --workspace=@campusnet/backend",
    "start": "npm run start --workspace=@campusnet/backend",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test --workspace=@campusnet/frontend",
    "test:backend": "npm run test --workspace=@campusnet/backend",
    "prisma:validate": "npm run prisma:validate --workspace=@campusnet/backend",
    "prisma:generate": "npm run prisma:generate --workspace=@campusnet/backend"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  }
}
